# Identificación del sistema
SISTEMA_NOMBRE=Eduardo-Trigo

# MQTT - Comunicación con la planta
MQTT_HOST=broker
MQTT_PORT=1883

# API de la planta
PLANTA_API_URL=http://sim:8100

# PostgreSQL. Completar con dos contraseñas aleatorias distintas antes de docker compose up.
# Administración e inicialización del volumen
POSTGRES_ADMIN_USER=pia3_admin
POSTGRES_ADMIN_PASSWORD=

# Rol de aplicación que usa el agente para sincronizar memoria en la red de Compose
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pia3
POSTGRES_USER=pia3_app
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT=5

# Identidad SHA-256 que devuelve la ingesta para la tool buscar_manuales
PIA3_RAG_CORPUS_ID=

# El proxy interno de planta se configura en el runtime de docker-compose.yml.
# Si la compilación necesita proxy, usa uno accesible desde el entorno de build.
